<?xml version="1.0"?>
<robot name="test_model">

  <!-- root link, on the ground just below the model origin -->
  <link name="base_footprint">
   <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.001 0.001 0.001" />
      </geometry>
    </visual>
  </link>

  <joint name="base_link_joint" type="fixed">
    <origin xyz="0 0 1.25" rpy="0 0 1.57" />
    <parent link="base_footprint"/>
    <child link="base_link" />
  </joint>

  <!-- the model -->
  <link name="base_link">
    <inertial>
      <mass value="50" />
      <origin xyz="0 0 -1.25" />
      <inertia ixx="10" ixy="0.0" ixz="0.0"
        iyy="10" iyz="0.0"
        izz="100" />
    </inertial>
    <!-- The meshes are generated by scripts/make_robot6th_meshes.py in the robot frame
         (metres, x forward, z = 0 at the floor, origin at the footprint centre). The origin
         below undoes base_link_joint (z 1.25, yaw 1.57) so they sit on base_footprint. -->
    <visual>
      <origin xyz="0 0 -1.25" rpy="0 0 -1.57"/>
      <geometry>
        <mesh filename="package://robot6th_description/meshes/robot6th.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -1.25" rpy="0 0 -1.57"/>
      <geometry>
        <mesh filename="package://robot6th_description/meshes/robot6th_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <gazebo>
    <plugin name="object_controller" filename="libgazebo_ros_planar_move.so">
      <commandTopic>PathPlan/RobotSpeed</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <odometryRate>20.0</odometryRate>
      <robotBaseFrame>base_footprint</robotBaseFrame>
    </plugin>
  </gazebo>

</robot>
