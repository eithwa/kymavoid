<?xml version="1.0"?>
<!-- Simulation: Gazebo (avoid_sim) + navigation (avoid_nav) + rosbridge for the web UI. -->
<launch>
  <arg name="sensor" default="camera"/>   <!-- camera | lidar -->
  <arg name="nav" default="true"/>
  <arg name="bridge_port" default="9090"/>
  <arg name="mjpeg_port" default="8080"/>
  <arg name="gui" default="true"/>
  <arg name="layout" default="random"/>   <!-- random | route | classic -->
  <arg name="seed" default="1"/>
  <include file="$(find avoid_sim)/launch/sim.launch">
    <arg name="sensor" value="$(arg sensor)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="layout" value="$(arg layout)"/>
    <arg name="seed" value="$(arg seed)"/>
  </include>
  <!-- nav:=false when avoid_*.sh runs nav_node in its own tmux window (restart it alone) -->
  <include if="$(arg nav)" file="$(find avoid_nav)/launch/nav.launch">
    <arg name="sensor" value="$(arg sensor)"/>
  </include>
  <!-- the virtual camera's /camera/black and /camera/red for the web UI, as on the robot -->
  <node if="$(eval sensor == 'camera')" name="mjpeg_server" pkg="mjpeg_server" type="mjpeg_server" respawn="true" respawn_delay="5">
    <param name="port" value="$(arg mjpeg_port)"/>
  </node>
  <!-- pings every node: crashed nodes stay registered with the master (web UI node list) -->
  <node name="node_watch" pkg="avoid_bringup" type="node_watch.py"/>
  <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch">
    <arg name="port" value="$(arg bridge_port)"/>
  </include>
</launch>
